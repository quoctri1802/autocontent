# MBTE System Configuration
PORT=8000
HOST=0.0.0.0

# Gemini API Key (For Content Planning and Script Writing)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres Database URL (For Website database sync)
DATABASE_URL=postgresql://user:password@ep-host.neon.tech/dbname?sslmode=require

# Facebook Page Graph API (For standard posts)
FB_PAGE_ID=your_facebook_page_id_here
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Pexels API Key (For downloading stock images/videos)
# Register at: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Playwright Browser Upload Cookies (Path to JSON cookie file or base64 string)
TIKTOK_COOKIES_PATH=cookies/tiktok.json
FACEBOOK_COOKIES_PATH=cookies/facebook.json
YOUTUBE_COOKIES_PATH=cookies/youtube.json
